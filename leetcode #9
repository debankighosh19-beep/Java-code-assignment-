import java.util.*;

public class Main {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int x = sc.nextInt();

        if (x < 0 || (x % 10 == 0 && x != 0)) {
            System.out.println("false");
            sc.close();
            return;
        }

        int original = x;
        int reversed = 0;

        while (x > 0) {
            int digit = x % 10;
            reversed = reversed * 10 + digit;
            x = x / 10;
        }

        if (original == reversed) {
            System.out.println("true");
        }
        else {
            System.out.println("false");
        }

        sc.close();
    }
}
